<Window x:Class="ConvertToUHD.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ConvertToUHD" Height="260" Width="780"
        AllowDrop="True">
    <Grid x:Name="RootGrid" Margin="12" AllowDrop="True" Background="Transparent"
          PreviewDragOver="Root_PreviewDragOver"
          PreviewDrop="Root_PreviewDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontSize="18" FontWeight="SemiBold"
                   Text="Excel → UHD PNG (Drag 'n' Drop .xlsx)" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
            <TextBox x:Name="OutputTextBox" Width="620" IsReadOnly="True" />
            <Button Content="Select Output…" Width="150" Margin="10,0,0,0"
                    Click="SelectOutput_Click"/>
        </StackPanel>

        <GroupBox Grid.Row="2" Header="Queue" Margin="0,12,0,0" AllowDrop="True" >
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ListBox x:Name="FileListBox" Grid.Row="0" AllowDrop="True" />

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Add Files..." Width="130" Click="AddFiles_Click" />
                    <Button Content="Remove Selected" Width="150" Margin="10,0,0,0" Click="RemoveSelected_Click"/>
                    <Button Content="Clear" Width="90" Margin="12,6,0,0" Click="Clear_Click"/>
                    <TextBlock x:Name="HintText" Margin="12,6,0,0" Text="Tip: Drag 'n' drop .xlsx files into the window."/>
                </StackPanel>
            </Grid>
        </GroupBox>
        
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="ConvertAllButton" Content="Convert All" Width="130" Click="ConvertAll_Click" />
            <ProgressBar x:Name="ProgressBar" Width="240" Height="18" Margin="12,4,0,0" Minimum="0" Maximum="100" />
            <TextBlock x:Name="StatusText" Margin="12,6,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Window>
