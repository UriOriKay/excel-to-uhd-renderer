<Window x:Class="ConvertToUHD.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ConvertToUHD" Height="260" Width="780">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontSize="18" FontWeight="SemiBold"
                   Text="Excel → UHD PNG" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
            <TextBox x:Name="InputTextBox" Width="600" IsReadOnly="True" />
            <Button Content="Select Excel…" Width="130" Margin="10,0,0,0"
                    Click="SelectExcel_Click"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
            <TextBox x:Name="OutputTextBox" Width="600" IsReadOnly="True" />
            <Button Content="Select Output…" Width="130" Margin="10,0,0,0"
                    Click="SelectOutput_Click"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,14,0,0">
            <Button Content="Convert" Width="130" Click="Convert_Click"/>
            <TextBlock x:Name="StatusText" Margin="12,6,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Window>
